# Copia de referencia: NUNCA subir un .env con valores reales. En el VPS los valores viven en
# /etc/curso-hfc/api.env y /etc/curso-hfc/carga.env (chmod 600). En GitHub Actions, en Secrets.

# --- API (login curso_hfc_app: solo SELECT) ---
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=BD_CURSO_HFC
DB_USER=curso_hfc_app
DB_PASSWORD=
# Mínimo 32 caracteres. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_HORAS=10
CACHE_TTL_S=60
LOGIN_INTENTOS_MAX=5
LOGIN_VENTANA_S=900

# --- Semilla (login curso_hfc_carga: lee/escribe solo BD_CURSO_HFC) ---
# DB_USER=curso_hfc_carga
# DB_PASSWORD=
CLAVE_ADMIN=
CLAVE_SUPERVISOR=
CLAVE_CLIENTE=
